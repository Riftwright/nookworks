        "content": "biodiesel",
        "level": "4"
      },
      "apply": {
        "model": "nookworks:block/copper_tank_gauge_biodiesel_4"
      }
    },
    {
      "when": {
        "content": "biodiesel",
        "level": "5"
      },
      "apply": {
        "model": "nookworks:block/copper_tank_gauge_biodiesel_5"
      }
    },
