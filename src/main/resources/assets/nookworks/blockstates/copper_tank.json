      }
    },
    {
      "when": {
        "port_north": "true"
      },
      "apply": {
        "model": "nookworks:block/pipe_port"
      }
    },
    {
      "when": {
        "port_east": "true"
      },
      "apply": {
        "model": "nookworks:block/pipe_port",
        "y": 90
      }
    },
    {
      "when": {
        "port_south": "true"
      },
      "apply": {
        "model": "nookworks:block/pipe_port",
        "y": 180
      }
    },
    {
      "when": {
