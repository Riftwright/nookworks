      "apply": {
        "model": "nookworks:block/copper_tank_gauge_empty"
      }
    },
    {
      "when": {
        "content": "biodiesel",
        "level": "1"
      },
      "apply": {
        "model": "nookworks:block/copper_tank_gauge_biodiesel_1"
