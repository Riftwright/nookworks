{
  "multipart": [
    {
      "apply": {
        "model": "nookworks:block/copper_tank"
      }
    },
    {
      "when": {
        "content": "empty"
      },
      "apply": {
        "model": "nookworks:block/copper_tank_gauge_empty"
      }
    },
    {
      "when": {
        "content": "water",
        "level": "0"
      },
      "apply": {
        "model": "nookworks:block/copper_tank_gauge_empty"
      }
    },
    {
      "when": {
        "content": "water",
        "level": "1"
      },
      "apply": {
        "model": "nookworks:block/copper_tank_gauge_water_1"
      }
    },
    {
      "when": {
        "content": "water",
        "level": "2"
      },
      "apply": {
        "model": "nookworks:block/copper_tank_gauge_water_2"
      }
    },
    {
      "when": {
        "content": "water",
        "level": "3"
      },
      "apply": {
        "model": "nookworks:block/copper_tank_gauge_water_3"
      }
    },
    {
      "when": {
        "content": "water",
        "level": "4"
      },
      "apply": {
        "model": "nookworks:block/copper_tank_gauge_water_4"
      }
    },
    {
      "when": {
        "content": "water",
        "level": "5"
      },
      "apply": {
        "model": "nookworks:block/copper_tank_gauge_water_5"
      }
    },
    {
      "when": {
        "content": "water",
        "level": "6"
      },
      "apply": {
        "model": "nookworks:block/copper_tank_gauge_water_6"
      }
    },
    {
      "when": {
        "content": "oil",
        "level": "0"
      },
      "apply": {
        "model": "nookworks:block/copper_tank_gauge_empty"
      }
    },
    {
      "when": {
        "content": "oil",
        "level": "1"
      },
      "apply": {
        "model": "nookworks:block/copper_tank_gauge_oil_1"
      }
    },
    {
      "when": {
        "content": "oil",
        "level": "2"
      },
      "apply": {
        "model": "nookworks:block/copper_tank_gauge_oil_2"
      }
    },
    {
      "when": {
        "content": "oil",
        "level": "3"
      },
      "apply": {
        "model": "nookworks:block/copper_tank_gauge_oil_3"
      }
    },
    {
      "when": {
        "content": "oil",
        "level": "4"
      },
      "apply": {
        "model": "nookworks:block/copper_tank_gauge_oil_4"
      }
    },
    {
      "when": {
        "content": "oil",
