    },
    {
      "when": {
        "content": "other",
        "level": "1"
      },
      "apply": {
        "model": "nookworks:block/copper_tank_gauge_other_1"
      }
    },
    {
      "when": {
        "content": "other",
        "level": "2"
      },
      "apply": {
        "model": "nookworks:block/copper_tank_gauge_other_2"
      }
    },
    {
      "when": {
        "content": "other",
        "level": "3"
      },
      "apply": {
        "model": "nookworks:block/copper_tank_gauge_other_3"
      }
    },
    {
      "when": {
        "content": "other",
        "level": "4"
      },
      "apply": {
        "model": "nookworks:block/copper_tank_gauge_other_4"
