{
  "multipart": [
    {
      "apply": {
        "model": "nookworks:block/water_pump"
      }
    },
    {
      "when": {
        "running": "true"
      },
      "apply": {
        "model": "nookworks:block/water_pump_lamp"
      }
    },
    {
      "when": {
        "port_north": "true"
      },
      "apply": {
        "model": "nookworks:block/pipe_port"
      }
    },
    {
      "when": {
        "port_east": "true"
      },
      "apply": {
        "model": "nookworks:block/pipe_port",
        "y": 90
      }
    },
    {
      "when": {
        "port_south": "true"
      },
      "apply": {
        "model": "nookworks:block/pipe_port",
        "y": 180
      }
    },
    {
      "when": {
        "port_west": "true"
      },
      "apply": {
        "model": "nookworks:block/pipe_port",
        "y": 270
      }
    },
    {
      "when": {
        "port_down": "true"
      },
      "apply": {
        "model": "nookworks:block/pipe_port",
        "x": 90
      }
    }
  ]
}
