      },
      "apply": {
        "model": "nookworks:block/diesel_generator_lamp"
      }
    },
    {
      "when": {
        "facing": "west"
      },
      "apply": {
        "model": "nookworks:block/diesel_generator",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "west",
        "lit": "true"
      },
      "apply": {
        "model": "nookworks:block/diesel_generator_lamp",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "north"
      },
      "apply": {
        "model": "nookworks:block/diesel_generator",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "north",
        "lit": "true"
      },
      "apply": {
        "model": "nookworks:block/diesel_generator_lamp",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "east"
      },
      "apply": {
        "model": "nookworks:block/diesel_generator",
