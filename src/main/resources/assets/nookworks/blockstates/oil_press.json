{
  "multipart": [
    {
      "when": {
        "facing": "north"
      },
      "apply": {
        "model": "nookworks:block/oil_press_base"
      }
    },
    {
      "when": {
        "facing": "east"
      },
      "apply": {
        "model": "nookworks:block/oil_press_base",
        "y": 90
      }
    },
    {
      "when": {
        "facing": "south"
      },
      "apply": {
        "model": "nookworks:block/oil_press_base",
        "y": 180
      }
    },
    {
      "when": {
        "facing": "west"
      },
      "apply": {
        "model": "nookworks:block/oil_press_base",
        "y": 270
      }
    },
    {
      "when": {
        "oil": "1"
      },
      "apply": {
        "model": "nookworks:block/oil_press_oil_1"
      }
    },
    {
      "when": {
        "oil": "2"
      },
      "apply": {
        "model": "nookworks:block/oil_press_oil_2"
      }
    },
    {
      "when": {
        "port_north": "true"
      },
      "apply": {
        "model": "nookworks:block/oil_press_port"
      }
    },
    {
      "when": {
        "port_east": "true"
      },
      "apply": {
        "model": "nookworks:block/oil_press_port",
        "y": 90
      }
    },
    {
      "when": {
        "port_south": "true"
      },
      "apply": {
        "model": "nookworks:block/oil_press_port",
        "y": 180
      }
    },
    {
      "when": {
        "port_west": "true"
      },
      "apply": {
        "model": "nookworks:block/oil_press_port",
        "y": 270
      }
    }
  ]
}
