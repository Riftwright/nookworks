{
  "multipart": [
    {
      "when": {
        "hanging": "false"
      },
      "apply": {
        "model": "minecraft:block/copper_lantern"
      }
    },
    {
      "when": {
        "hanging": "true"
      },
      "apply": {
        "model": "minecraft:block/copper_lantern_hanging"
      }
    },
    {
      "when": {
        "hanging": "false"
      },
      "apply": {
        "model": "nookworks:block/lantern_soot_copper"
      }
    },
    {
      "when": {
        "hanging": "true"
      },
      "apply": {
        "model": "nookworks:block/lantern_soot_copper_hanging"
      }
    }
  ]
}
